# ============================================================================
# Environment Configuration
# Copy this file to `.env` and replace the placeholder values below.
# ============================================================================

# Server Port
PORT=3000

# Runtime environment (development, production, staging, test)
NODE_ENV=development

# GitHub Personal Access Token (PAT)
#
# Required to fetch repository data from GitHub.
#
# Create a fine-grained PAT:
# https://github.com/settings/personal-access-tokens
#
# Required permissions:
#   - Issues: Read-only
#   - Metadata: Read-only
#   - Pull requests: Read-only
#
# Repository access:
#   - All repositories (recommended for full context)
#
# Documentation:
# https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/creating-a-personal-access-token
GITHUB_TOKEN=

# This project is intended solely for personal use.
# A GitHub username is required to retrieve data from GitHub.
GITHUB_USERNAME=


# Wakatime username
WAKATIME_USERNAME=

# Wakatime Token
WAKATIME_TOKEN=

# Wakatime url
WAKATIME_URL=

# Default theme
DEFAULT_THEME=

# Default locale
DEFAULT_LOCALE=